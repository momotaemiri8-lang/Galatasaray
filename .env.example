# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_API_BASE_URL: Optional public build-time backend API URL for static frontend hosts (e.g., Netlify).
# Leave empty when serving from the same origin, or set to the Cloud Run service URL before running `npm run build`.
VITE_API_BASE_URL="https://ais-pre-2ogzxwcpbrpxkhvs5esgzn-97089877236.europe-west2.run.app"

# Cloud SQL Runtime Environment Variables (injected automatically by AI Studio Cloud SQL Proxy)
SQL_HOST="/cloudsql/instance"
SQL_USER="app_user"
SQL_PASSWORD="app_password"
SQL_DB_NAME="postgres"
SQL_ADMIN_USER="admin_user"
SQL_ADMIN_PASSWORD="admin_password"

# Payment & Logistics Gateway Environment Variables (configured via AI Studio Secrets Panel)

# 1. Stripe Payments Integration
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# 2. PayPal REST API v2 Integration
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_ENVIRONMENT="sandbox"

# 3. DHL Express (MyDHL API) Integration
DHL_EXPRESS_API_KEY=""
DHL_EXPRESS_API_SECRET=""
DHL_EXPRESS_ACCOUNT_NUMBER=""
DHL_EXPRESS_ENVIRONMENT="test"

# 4. Transactional Email (SMTP) Integration
SMTP_TRANSACTIONAL_HOST=""
SMTP_TRANSACTIONAL_PORT="587"
SMTP_TRANSACTIONAL_USER=""
SMTP_TRANSACTIONAL_PASS=""
SMTP_FROM_EMAIL="no-reply@galatasaray.org"

# 5. Live Football Data Provider Integration (API-Football v3 or Football-Data.org v4)
FOOTBALL_API_PROVIDER="api-football"
FOOTBALL_API_KEY=""
FOOTBALL_API_BASE_URL="https://v3.football.api-sports.io"
FOOTBALL_TEAM_ID="645"
FOOTBALL_COMPETITION_IDS="203,2"
FOOTBALL_TIMEZONE="Europe/Istanbul"


